{
  "name": "eden-glow-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "firebase emulators:exec --only auth,firestore --project demo-eden-glow \"vitest run\"",
    "test:unit": "vitest run tests/engine.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-eden-glow",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.34.1",
    "typescript": "~5.9.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
