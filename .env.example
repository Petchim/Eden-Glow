# Firebase web app config: Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# Copy this file to .env.local and fill in the values. .env.local is ignored by Git; never commit it.
# These identify the project and are not secrets, but NEVER put a service-account key or any
# Firebase Admin SDK credential in a VITE_ variable: everything here ends up in the browser.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Local development against the Firebase emulators (`npm run emulators`) instead of the real project.
VITE_FIREBASE_USE_EMULATORS=false

# true = run the admin on in-browser demo data only (no Firebase, NOT secure). Never set in production.
VITE_ADMIN_DEMO=false
