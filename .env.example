# Firebase web app config: Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# Copy this file to .env.local and fill in the values. .env.local is ignored by Git; never commit it.
# These identify the project and are not secrets, but NEVER put a service-account key or any
# Firebase Admin SDK credential in a VITE_ variable: everything here ends up in the browser.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Instagram gallery Worker (optional): its address, no trailing slash, e.g.
# https://eden-glow-instagram.<your-subdomain>.workers.dev — leave empty until the Worker is deployed.
VITE_INSTAGRAM_API_URL=

# Cloudflare R2 media (optional): public delivery domain, e.g. https://media.example.com or https://pub-<id>.r2.dev
VITE_MEDIA_BASE_URL=
# Upload gateway Worker address (leave empty to use the in-browser demo in demo mode)
VITE_MEDIA_API_URL=

# Server-side / CLI only (scripts/migrate-to-r2.mjs). NEVER prefix with VITE_ and never commit real values:
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=eden-glow-media

# Local development against the Firebase emulators (`npm run emulators`) instead of the real project.
VITE_FIREBASE_USE_EMULATORS=false

# true = run the admin on in-browser demo data only (no Firebase, NOT secure). Never set in production.
VITE_ADMIN_DEMO=false
